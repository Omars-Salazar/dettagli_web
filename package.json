{
  "name": "tienda-regalos",
  "version": "1.0.0",
  "description": "Inventario y pedidos para tienda de regalos",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": { "dotenv": "^16.4.5", "mysql2": "^3.11.0", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1", "concurrently": "^8.2.2", "electron": "^31.0.0",
    "electron-builder": "^24.13.3", "vite": "^5.4.0", "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "co.regalos.tienda",
    "productName": "Tienda Regalos",
    "files": ["dist/**", "electron/**", "package.json", ".env"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
